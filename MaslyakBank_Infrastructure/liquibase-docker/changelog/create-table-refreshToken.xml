<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Создание таблицы refresh_token -->
    <changeSet id="1-create-refresh-token" author="maslyak">
        <createTable tableName="refresh_token">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_token_id" type="uuid">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="token" type="varchar(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="revoked" type="boolean" defaultValueBoolean="false"/>
            <column name="expired_at" type="timestamp"/>
            <column name="created_at" type="timestamp"/>
            <column name="updated_at" type="timestamp"/>
        </createTable>
    </changeSet>

    <!-- Внешний ключ на таблицу user_token -->
    <changeSet id="2-add-fk-refresh-token-user-token" author="maslyak">
        <addForeignKeyConstraint
                baseTableName="refresh_token"
                baseColumnNames="user_token_id"
                constraintName="fk_refresh_token_user_token"
                referencedTableName="user_token"
                referencedColumnNames="id"
                onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
