<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- 2. Добавление внешнего ключа profiles.user_id -> users.id -->
    <changeSet id="add-fk-profile-user" author="maslyak">
        <addForeignKeyConstraint
                baseTableName="profiles"
                baseColumnNames="user_id"
                constraintName="fk_profiles_users"
                referencedTableName="users"
                referencedColumnNames="id"
                onDelete="CASCADE"/>
    </changeSet>

    <!-- 3. Добавить уникальный индекс, чтобы OneToOne было реальным -->
    <changeSet id="add-unique-profile-user" author="maslyak">
        <addUniqueConstraint
                tableName="profiles"
                columnNames="user_id"
                constraintName="uq_profiles_user_id"/>
    </changeSet>

</databaseChangeLog>
